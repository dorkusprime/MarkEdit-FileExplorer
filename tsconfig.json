{
  "compilerOptions": {
    "module": "esnext",
    "target": "es2022",
    "lib": [
      "es2022",
      "dom",
      "dom.iterable"
    ],
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "main.ts",
    "src/**/*.ts",
    "test/**/*.ts"
  ]
}
